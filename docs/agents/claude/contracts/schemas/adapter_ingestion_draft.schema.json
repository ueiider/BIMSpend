{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimspend.example.com/schemas/adapter_ingestion_draft.schema.json",
  "title": "Adapter Ingestion Draft Event (Miru Submission)",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "timestamp_utc", "source", "correlation", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "adapter.ingestion.draft" },
    "schema_version": { "const": "1.0.0" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["component", "version", "instance_id", "process_id"],
      "additionalProperties": false,
      "properties": {
        "component": { "const": "windows-adapter" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "instance_id": { "type": "string", "format": "uuid" },
        "process_id": { "type": "integer", "minimum": 0 }
      }
    },
    "correlation": {
      "type": "object",
      "required": ["session_id", "run_id"],
      "additionalProperties": false,
      "properties": {
        "session_id": { "type": "string", "format": "uuid" },
        "run_id": { "type": "string", "format": "uuid" },
        "external_run_id": { "type": "string" },
        "external_session_id": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "required": ["timesheet_entry", "agent"],
      "additionalProperties": false,
      "properties": {
        "timesheet_entry": {
          "type": "object",
          "required": ["external_run_id", "external_session_id", "duration_minutes", "work_date", "project_id", "source", "note", "proof_url", "source_metadata", "proof_metadata"],
          "additionalProperties": false,
          "properties": {
            "external_run_id": { "type": "string", "minLength": 1, "maxLength": 255 },
            "external_session_id": { "type": "string", "minLength": 1, "maxLength": 255 },
            "duration_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
            "work_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "project_id": { "type": "string", "format": "uuid" },
            "source": { "const": "automation" },
            "note": { "type": "string", "maxLength": 2000 },
            "proof_url": { "type": "string", "format": "uri", "maxLength": 500 },
            "source_metadata": {
              "type": "object",
              "required": ["correlation_confidence", "observed_seconds", "active_seconds", "afk_seconds", "evidence_event_ids", "model_identity", "attribution_factors"],
              "additionalProperties": false,
              "properties": {
                "correlation_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
                "observed_seconds": { "type": "integer", "minimum": 0 },
                "active_seconds": { "type": "integer", "minimum": 0 },
                "afk_seconds": { "type": "integer", "minimum": 0 },
                "evidence_event_ids": { "type": "array", "items": { "type": "string", "format": "uuid" } },
                "model_identity": {
                  "type": "object",
                  "required": ["type"],
                  "additionalProperties": false,
                  "properties": {
                    "type": { "type": "string", "enum": ["workshared_central", "standalone_file", "acc_cloud_model", "detached", "unsaved", "unmapped"] },
                    "central_path": { "type": ["string", "null"] },
                    "central_guid": { "type": ["string", "null"] }
                  }
                },
                "attribution_factors": {
                  "type": "object",
                  "required": ["revit_foreground", "document_match", "view_active", "afk_excluded", "single_revit_process"],
                  "additionalProperties": false,
                  "properties": {
                    "revit_foreground": { "type": "boolean" },
                    "document_match": { "type": "boolean" },
                    "view_active": { "type": "boolean" },
                    "afk_excluded": { "type": "boolean" },
                    "single_revit_process": { "type": "boolean" }
                  }
                }
              }
            },
            "proof_metadata": {
              "type": "object",
              "required": ["window_events", "afk_events", "revit_idling_events", "correlation_algorithm", "privacy_filter_applied"],
              "additionalProperties": false,
              "properties": {
                "window_events": { "type": "integer", "minimum": 0 },
                "afk_events": { "type": "integer", "minimum": 0 },
                "revit_idling_events": { "type": "integer", "minimum": 0 },
                "correlation_algorithm": { "type": "string", "pattern": "^v\\d+\\.\\d+$" },
                "privacy_filter_applied": { "type": "boolean" }
              }
            }
          }
        },
        "agent": {
          "type": "object",
          "required": ["agent_key_id", "company_id"],
          "additionalProperties": false,
          "properties": {
            "agent_key_id": { "type": "string", "minLength": 1 },
            "company_id": { "type": "string", "format": "uuid" }
          }
        }
      }
    }
  }
}