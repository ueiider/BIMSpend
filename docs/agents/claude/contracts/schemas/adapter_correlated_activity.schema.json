{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimspend.example.com/schemas/adapter_correlated_activity.schema.json",
  "title": "Adapter Correlated Activity Event",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "timestamp_utc", "source", "correlation", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "adapter.correlated.activity" },
    "schema_version": { "const": "1.0.0" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["component", "version", "instance_id", "process_id"],
      "additionalProperties": false,
      "properties": {
        "component": { "const": "windows-adapter" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "instance_id": { "type": "string", "format": "uuid" },
        "process_id": { "type": "integer", "minimum": 0 }
      }
    },
    "correlation": {
      "type": "object",
      "required": ["session_id", "run_id"],
      "additionalProperties": false,
      "properties": {
        "session_id": { "type": "string", "format": "uuid" },
        "run_id": { "type": "string", "format": "uuid" },
        "external_run_id": { "type": "string" },
        "external_session_id": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "required": ["interval", "attribution", "activity", "evidence"],
      "additionalProperties": false,
      "properties": {
        "interval": {
          "type": "object",
          "required": ["start_utc", "end_utc", "duration_seconds"],
          "additionalProperties": false,
          "properties": {
            "start_utc": { "type": "string", "format": "date-time" },
            "end_utc": { "type": "string", "format": "date-time" },
            "duration_seconds": { "type": "integer", "minimum": 1 }
          }
        },
        "attribution": {
          "type": "object",
          "required": ["project_id", "project_name", "model_identity", "confidence", "confidence_factors"],
          "additionalProperties": false,
          "properties": {
            "project_id": { "type": "string", "format": "uuid" },
            "project_name": { "type": "string", "minLength": 1 },
            "model_identity": {
              "type": "object",
              "required": ["type"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["workshared_central", "standalone_file", "acc_cloud_model", "detached", "unsaved", "unmapped"] },
                "central_path": { "type": ["string", "null"] },
                "central_guid": { "type": ["string", "null"] },
                "document_title": { "type": ["string", "null"] },
                "acc_project_id": { "type": ["string", "null"] },
                "acc_model_id": { "type": ["string", "null"] },
                "file_path": { "type": ["string", "null"] },
                "file_hash": { "type": ["string", "null"] }
              }
            },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "confidence_factors": {
              "type": "object",
              "required": ["revit_foreground", "document_match", "view_active", "afk_excluded", "single_revit_process"],
              "additionalProperties": false,
              "properties": {
                "revit_foreground": { "type": "boolean" },
                "document_match": { "type": "boolean" },
                "view_active": { "type": "boolean" },
                "afk_excluded": { "type": "boolean" },
                "single_revit_process": { "type": "boolean" }
              }
            }
          }
        },
        "activity": {
          "type": "object",
          "required": ["observed_seconds", "active_seconds", "afk_seconds", "idle_seconds", "revit_foreground_seconds", "other_app_seconds"],
          "additionalProperties": false,
          "properties": {
            "observed_seconds": { "type": "integer", "minimum": 0 },
            "active_seconds": { "type": "integer", "minimum": 0 },
            "afk_seconds": { "type": "integer", "minimum": 0 },
            "idle_seconds": { "type": "integer", "minimum": 0 },
            "revit_foreground_seconds": { "type": "integer", "minimum": 0 },
            "other_app_seconds": { "type": "integer", "minimum": 0 }
          }
        },
        "evidence": {
          "type": "object",
          "required": ["window_events_count", "afk_events_count", "revit_idling_events_count", "source_event_ids"],
          "additionalProperties": false,
          "properties": {
            "window_events_count": { "type": "integer", "minimum": 0 },
            "afk_events_count": { "type": "integer", "minimum": 0 },
            "revit_idling_events_count": { "type": "integer", "minimum": 0 },
            "source_event_ids": {
              "type": "array",
              "items": { "type": "string", "format": "uuid" },
              "maxItems": 1000
            }
          }
        }
      }
    }
  }
}