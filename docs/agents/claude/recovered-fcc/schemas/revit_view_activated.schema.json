{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bimspend.example.com/schemas/revit_view_activated.schema.json",
  "title": "Revit View Activated Event",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "timestamp_utc", "source", "correlation", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "event_type": { "const": "revit.view.activated" },
    "schema_version": { "const": "1.0.0" },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": ["component", "version", "instance_id", "process_id"],
      "additionalProperties": false,
      "properties": {
        "component": { "const": "revit-connector" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "instance_id": { "type": "string", "format": "uuid" },
        "process_id": { "type": "integer", "minimum": 0 }
      }
    },
    "correlation": {
      "type": "object",
      "required": ["session_id", "run_id"],
      "additionalProperties": false,
      "properties": {
        "session_id": { "type": "string", "format": "uuid" },
        "run_id": { "type": "string", "format": "uuid" },
        "external_run_id": { "type": "string" },
        "external_session_id": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "required": ["document_id", "previous_view", "current_view"],
      "additionalProperties": false,
      "properties": {
        "document_id": { "type": "string", "format": "uuid" },
        "previous_view": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "view_id": { "type": "integer" },
            "view_name": { "type": "string", "minLength": 1 },
            "view_type": { "type": "string", "minLength": 1 }
          }
        },
        "current_view": {
          "type": "object",
          "required": ["view_id", "view_name", "view_type"],
          "additionalProperties": false,
          "properties": {
            "view_id": { "type": "integer" },
            "view_name": { "type": "string", "minLength": 1 },
            "view_type": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}